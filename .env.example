# --- API ---
PORT=3000
# When set, all requests (except /health and /docs) must send "X-API-Key: <value>"
API_KEY=

# --- yt-dlp ---
# Path to the yt-dlp executable (default: "yt-dlp" from PATH)
YTDLP_PATH=yt-dlp
# Where files are saved; each job gets its own sub-folder
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=2
# Netscape-format cookies file (age-restricted, members-only, private content)
YTDLP_COOKIES_FILE=
# Extra args appended to every yt-dlp call, space separated
# e.g. --proxy socks5://127.0.0.1:1080 --sleep-requests 1
YTDLP_EXTRA_ARGS=
# Timeout for /info and /formats
INFO_TIMEOUT_MS=60000

# --- SFTP (optional, for POST /downloads/:id/push-sftp) ---
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PRIVATE_KEY_PATH=./sftp-keys/id_ed25519
SFTP_PRIVATE_KEY_PASSPHRASE=
